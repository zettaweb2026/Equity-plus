NODE_ENV=production

# Your deployed frontend domain, without a trailing slash.
FRONTEND_URL=https://your-frontend-project.vercel.app

# If you use preview deployments, set this true in Vercel.
ALLOW_VERCEL_PREVIEWS=false

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/equity_plus
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
