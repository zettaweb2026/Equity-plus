NODE_ENV=production

# Your deployed frontend domain, without a trailing slash.
FRONTEND_URL=https://equity-plus-xtp8.vercel.app

# Keep true for Vercel preview deployments. Set false only if you want to allow FRONTEND_URL only.
ALLOW_VERCEL_PREVIEWS=true

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/equity_plus
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
