PORT=4000
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS.
# Local development example:
FRONTEND_URLS=http://localhost:5174,http://localhost:5173

# Set this in Vercel/backend project settings for auth routes.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/equity_plus
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: allow Vercel preview deployment URLs like https://branch-project.vercel.app
ALLOW_VERCEL_PREVIEWS=false
